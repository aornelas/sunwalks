# Postgres connection string. The default matches docker-compose.yml.
DATABASE_URL=postgres://sunrise:sunrise@localhost:5432/sunrise_calendar

# Google Cloud OAuth client. Enable the "Google Photos Picker API" (not the
# old Photos Library API — see README's "Google Photos access" section) and
# add https://www.googleapis.com/auth/photospicker.mediaitems.readonly to the
# OAuth consent screen's scopes. Authorized redirect URI must be
# {SITE_URL}/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random passphrase — hashed into the AES-256 key that encrypts the
# stored Google refresh token. Generate with: openssl rand -base64 32
APP_SECRET=

# Optional: lock sign-in to exactly this Google account. Recommended once you
# know the address, since anyone can otherwise claim the (currently empty)
# owner slot on first login.
OWNER_EMAIL=

# Public origin, used to build the OAuth redirect URI and share links.
SITE_URL=http://localhost:3000

# IANA timezone the owner's "sunrise" days are measured in.
APP_TIMEZONE=America/Los_Angeles

# Vercel Blob read/write token for the private store imported photos are
# saved to (src/lib/storage.ts). Create a Blob store in the Vercel dashboard
# and copy its token, or run `vercel env pull`. Not needed in demo mode.
BLOB_READ_WRITE_TOKEN=

# Local preview only: bypasses auth and serves the bundled sample photos from
# public/seed-photos/ (run `npm run db:seed` first). Never enable in production.
DEMO_MODE=false

# Owner's home coordinates — feeds the planning view's forecast (Open-Meteo)
# and solar-position math (first light / sunrise / golden-hour end). Defaults
# to San Francisco if unset.
OWNER_LAT=37.7749
OWNER_LON=-122.4194

# Claude API key for vision tagging, walk plans and the Telegram walk buddy.
# Not needed to run the calendar; untagged photos simply have no alt text or
# sky category yet.
ANTHROPIC_API_KEY=
# Optional: the model that tags photos. Defaults to claude-opus-5-5.
TAGGING_MODEL=
# Optional: the model that plans walks and files feedback. Defaults to claude-opus-5-5.
RECOMMEND_MODEL=

# Vercel sends this as a bearer token to the cron jobs in vercel.json (the
# nightly forecast, the evening plan and the weekly summary). Any long
# random string: openssl rand -base64 32
CRON_SECRET=

# The Telegram walk buddy (docs/architecture.md). Leave these empty to keep
# the bot off. The token comes from @BotFather; `npm run telegram -- chats`
# finds your chat ID after you've sent the bot /start; the webhook secret is
# letters, digits, _ and - only: openssl rand -hex 32
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
